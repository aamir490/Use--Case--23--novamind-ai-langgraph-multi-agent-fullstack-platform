# ── Agent Service — Environment Variables ────────────────────
# Copy this file to .env and fill in your values

# Server
PORT=8003
NODE_ENV=development

# MongoDB Atlas connection string
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0/agent
MONGODB_URI=your_mongodb_atlas_connection_string

# Redis (conversation memory + rate limiting)
REDIS_URL=redis://localhost:6379

# ── LLM API Keys ──────────────────────────────────────────────

# Groq — used for Chat, Search, PDF, PPT, Vision agents
# Get from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key

# Google Gemini — used for Image Analyzer agent + PDF RAG embeddings
# Get from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_gemini_api_key

# OpenRouter — used for Coding agent (DeepSeek model)
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key

# Tavily — used for Web Search agent
# Get from: https://app.tavily.com/
TAVILY_API_KEY=your_tavily_api_key

# ── Internal Service URLs ─────────────────────────────────────
# (localhost for dev, ECS Service Discovery DNS for AWS)
CHAT_SERVICE=http://localhost:8002
AUTH_SERVICE=http://localhost:8001

# ── AWS S3 — File Storage (PPT + generated images) ───────────
# Get from: AWS Console → IAM → Users → Security credentials
# On AWS ECS: remove these and use IAM Task Role instead
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_KEY=your_aws_secret_access_key
AWS_BUCKET_NAME=your_s3_bucket_name

# ── Qdrant Cloud — Vector DB for PDF RAG ─────────────────────
# Get from: https://cloud.qdrant.io/
QDRANT_URL=your_qdrant_cluster_url
QDRANT_API_KEY=your_qdrant_api_key
