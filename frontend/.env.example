# ── Frontend — Environment Variables ─────────────────────────
# Copy this file to .env and fill in your values
# All VITE_ variables are embedded into the build at compile time

# Firebase Client SDK
# Get from: Firebase Console → Project Settings → General → Your apps → Web app
# Note: This is the PUBLIC client key — safe to expose in frontend code
VITE_FIREBASE_API_KEY=your_firebase_web_api_key

# Razorpay Public Key ID
# Get from: https://dashboard.razorpay.com/app/keys
# Note: This is the PUBLIC key — safe to expose in frontend code
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id

# API Gateway URL
# Local development:  http://localhost:8000
# AWS production:     https://your-alb-dns.us-east-1.elb.amazonaws.com
#                  or https://api.your-domain.com
VITE_SERVER_URL=http://localhost:8000
